# Codex config.toml — WZORZEC (publiczny)
# Kopiowany przez instalator do ~/.codex/config.toml (lub %USERPROFILE%\.codex\).
# Wszystkie ścieżki osobiste zastąpiono placeholderem <CODEX_HOME>,
# który instalator podmienia na właściwy katalog Codex na danej maszynie.
#
# PRZED UŻYCIEM:
#  1) Jeśli używasz opencodex (proxy), zostaw openai_base_url jak poniżej
#     i najpierw uruchom `ocx start`. W przeciwnym razie USUŃ ten wpis
#     i skonfiguruj własnego providera (model + klucz API).
#  2) Dopasuj `model` do swojego providera (np. gpt-5-ja, o4-mini, …).
#  3) Skasuj sekcje MCP, których nie używasz.

model_reasoning_effort = "high"
model = "inception/mercury-3"          # ZMIEŃ na swój model/provider

# --- Proxy opencodex (opcjonalne) -----------------------------------------
# Jeśli używasz opencodex, poniższe wskazuje na lokalne proxy (ocx start).
# Jeżeli NIE używasz opencodex — USUŃ te trzy linie.
openai_base_url = "http://127.0.0.1:10100/v1"
experimental_realtime_ws_base_url = "http://127.0.0.1:10100/v1"
model_catalog_json = "<CODEX_HOME>/opencodex-catalog.json"

approval_policy = "never"              # YOLO — dostosuj do własnych preferencji
sandbox_mode = "danger-full-access"    # jak wyżej
background_terminal_max_timeout = 14400000

# --- Placeholdery (podmieniane przez instalator) ---------------------------
# Instalator zastępuje <CODEX_HOME> realną ścieżką (np. $HOME/.codex).
# Nie edytuj tych linii ręcznie.

# --- Pluginy OpenAI (bundled / primary-runtime) ---------------------------
# Uwaga: ścieżki do "marketplaces" i pluginów montuje aplikacja Codex/
# opencodex automatycznie; poniższe są domyślnie włączone, gdy są dostępne.
[plugins."codex-app-tools@openai-bundled"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."unified-computer-use@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

# --- MCP: node_repl (tylko gdy dostępny w aplikacji Codex/ChatGPT) --------
[mcp_servers.node_repl]
args = []
command = "<NODE_REPL_BIN>"
env_vars = [
    "BROWSER_USE_ACCESS_EXECUTOR_ID",
    "BROWSER_USE_ACCESS_PIPE_PATH",
    "BROWSER_USE_ACCESS_VERIFYING_IDENTITY",
]
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = "<NODE_REPL_MODULES>"
NODE_REPL_NODE_PATH = "<NODE_REPL_NODE>"
NODE_REPL_TRUSTED_CODE_PATHS = "<CODEX_HOME>:<NODE_REPL_MODULES>"
CODEX_HOME = "<CODEX_HOME>"
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab,mcpapps"
BROWSER_USE_TINYSKY_ENABLED = "1"
NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME = ""
BROWSER_USE_CODEX_APP_BUILD_FLAVOR = "prod"
BROWSER_USE_CODEX_APP_VERSION = "26.1103.32239"
NODE_REPL_TRUSTED_SERVICES = "{\"browser\":\"<CODEX_HOME>/plugins/cache/openai-bundled/browser/26.1103.32239/scripts/browser-service.mjs\"}"
CODEX_CLI_PATH = "<CODEX_CLI_PATH>"

# --- MCP: GitHub -----------------------------------------------------------
[mcp_servers.github]
command = "npx"
args = [
    "@modelcontextprotocol/server-github",
]

# --- MCP: Playwright ------------------------------------------------------
[mcp_servers.playwright]
command = "npx"
args = [
    "@playwright/mcp@latest",
]

# --- MCP: Vercel ----------------------------------------------------------
[mcp_servers.vercel]
url = "https://mcp.vercel.com/"

# --- MCP: context7 --------------------------------------------------------
[mcp_servers.context7]
command = "npx"
args = [
    "-y",
    "@upstash/context7-mcp",
]

# --- MCP: Notion ----------------------------------------------------------
[mcp_servers.notion]
command = "npx"
args = [
    "-y",
    "@modelcontextprotocol/server-notion",
]

# --- Desktop / UI ---------------------------------------------------------
[desktop]
conversationDetailMode = "STEPS_PROSE"
ambient-suggestions-enabled = true
migratedFollowUpQueueToSteer = true
external-agent-import-sync-item-types = "all"
external-agent-import-sync-enabled = true
sansFontSize = 14
codeFontSize = 13
selected-avatar-id = "codex"
avatar-overlay-pet-visible = true
avatar-overlay-mascot-width-px = 143

# --- Projekty zaufane (PRZYKŁAD — dostosuj) -------------------------------
# [projects."/home/USER/Desktop/moj-projekt"]
# trust_level = "trusted"

# --- TUI ----------------------------------------------------------------
[tui]
screen_reader_detection_done = true

# --- Funkcje -------------------------------------------------------------
[features]
js_repl = false
