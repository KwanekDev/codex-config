{
  "$schema": "https://json.schemastore.org/hooks.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '<IMPECCABLE_BASH>' ] || '<IMPECCABLE_BASH>' hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '<IMPECCABLE_BASH>' ] || '<IMPECCABLE_BASH>' hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
